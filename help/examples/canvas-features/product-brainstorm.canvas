    },
    {
      "id": "text-hypothesis",
      "type": "text",
      "x": 80,
      "y": -260,
      "width": 320,
      "height": 100,
      "text": "**Hypothesis**\nUsers stay on cloud-only tools because *moving the data* feels lossy. Show a one-click roundtrip to disarm that fear.",
      "color": "3"
    },
    {
      "id": "text-experiment",
      "type": "text",
      "x": 80,
      "y": -120,
      "width": 320,
      "height": 100,
      "text": "**Experiment**\nLanding page A/B with an animated import → edit → export loop. Track sign-up rate vs control.",
      "color": "6"
    },
    {
      "id": "text-risk",
      "type": "text",
      "x": 80,
      "y": 20,
      "width": 320,
      "height": 100,
      "text": "**Risk**\nAnimation looks slick but obscures the actual data shape — could over-promise.",
      "color": "#d62828"
    }
  ],

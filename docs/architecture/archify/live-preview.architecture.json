  "cards": [
    {
      "dot": "cyan",
      "title": "Two tracks, not fourteen",
      "items": [
        "Block widgets get one StateField or ViewPlugin each; inline marks share a single plugin",
        "Eleven of the twelve block decorators come from blockDecorator(); frontmatter is the hand-written exception"
      ]
    },
    {
      "dot": "amber",
      "title": "Marks beat widgets",
      "items": [
        "Decoration.mark() is CSS-only and GPU-painted; a widget forces DOM reflow",
        "Bullets, rules and hard breaks use font-size 0 plus a pseudo-element instead of a widget"
      ]
    },
    {
      "dot": "rose",
      "title": "Cache by content, never share a node",
      "items": [
        "A widget re-enters the viewport as a fresh toDOM(), so eq() alone saves nothing",
        "math and mermaid cache markup strings; queryjs is the one live-DOM cache, so canvas and iframe state survives"
      ]
    }
  ]

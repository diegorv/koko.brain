    {
      "dot": "emerald",
      "title": "Rust core",
      "items": [
        "VaultIndex parses links, tags, tasks and frontmatter at scan time",
        "Reverse indexes stay in lock-step with entries",
        "The watcher thread drops dot-directory events"
      ]
    },
    {
      "dot": "violet",
      "title": "Search and storage",
      "items": [
        "FTS5 keyword search over notes_fts",
        "BGE-M3 embeddings, 1024-d, content-hash chunk skip",

# Sample personal-RAG configuration for koko.brain.
# Copy to `{vault}/.kokobrain/rag.toml` and edit for your chosen provider.
#
# Two providers are supported:
#   - "openai_compat":     any OpenAI-compatible API (Kimi, DeepSeek, OpenAI,
#                          Ollama, OpenRouter, …). Requires an API key.
#   - "claude_agent_sdk":  shells out to the local `claude` CLI, using your
#                          Pro/Max subscription auth. No API key in this file.
#
# Never commit your API key to this file — set it via the OS keyring
# (preferred) or via the env var named below.

[llm]
provider = "openai_compat"

# Default: Kimi K2.6 via Moonshot AI's OpenAI-compatible endpoint.
# The trailing `/v1` is mandatory for OpenAI-compat consumers.
endpoint = "https://api.moonshot.ai/v1"
model = "kimi-k2.6"

# Environment variable consulted as a fallback when the keyring lookup misses.
api_key_env = "MOONSHOT_API_KEY"

# OS keyring service name. The credential is stored under
# (service=api_key_keyring_service, user="default"). Leave empty to skip
# the keyring (useful for headless Linux without Secret Service).
api_key_keyring_service = "kokobrain-rag-moonshot"

# --- Alternative providers (commented examples) ---
#
# DeepSeek:
#   endpoint = "https://api.deepseek.com/v1"
#   model = "deepseek-chat"
#   api_key_env = "DEEPSEEK_API_KEY"
#   api_key_keyring_service = "kokobrain-rag-deepseek"
#
# Ollama (local, free):
#   endpoint = "http://localhost:11434/v1"
#   model = "qwen2.5:14b"
#   api_key_env = ""
#   api_key_keyring_service = ""
#
# OpenRouter (proxy to Claude, Gemini, etc):
#   endpoint = "https://openrouter.ai/api/v1"
#   model = "anthropic/claude-haiku-4.5"
#   api_key_env = "OPENROUTER_API_KEY"
#   api_key_keyring_service = "kokobrain-rag-openrouter"
#
# Claude via subscription (no API key — uses your local `claude` CLI auth):
#
#   [llm]
#   provider = "claude_agent_sdk"
#   # Model alias or full id. Aliases follow your Claude Code config.
#   model = "sonnet"   # or "opus", "haiku", or e.g. "claude-sonnet-4-6"
#
#   [llm.claude]
#   # Optional. Defaults to "claude" on $PATH.
#   # binary_path = "/opt/homebrew/bin/claude"
#   #
#   # Optional. Lower effort = smaller thinking budget = faster + cheaper on
#   # subscription quota. Choices: low, medium, high, xhigh, max.
#   # effort = "low"
#
# Prereqs for the claude_agent_sdk provider:
#   1. Install Claude Code: https://claude.com/claude-code
#   2. Run `claude` once interactively and sign in with the same Anthropic
#      account that owns your Pro/Max subscription.
#   3. Verify with `claude --version`.
# Caveats:
#   - Subscription rate limits apply (5h windows). No automatic fallback
#     when the quota is exhausted.
#   - The CLI auto-loads CLAUDE.md from cwd; we spawn from the OS temp dir
#     to avoid this, but other settings (~/.claude/settings.json) still apply.
#   - Each user of the app must install the CLI on their own machine.

[retrieval]
# Cosine-search candidates produced by the embedder, before reranking.
vector_top_k = 30

# Final candidates passed to the LLM after reranking. Keep small enough that
# the system prompt + retrieved context fits comfortably in the model's
# context window.
final_top_k = 5

# PostHog telemetry (opt-in, client-only).
# Copy to `.env` and fill in the project API key to enable analytics builds.
# Both values are read at build time via Vite (`import.meta.env.VITE_*`).
# When VITE_POSTHOG_KEY is empty, telemetry is a no-op even if the user opts in.
#
# Get the key from https://posthog.com -> Project -> Settings -> Project API Key.
VITE_POSTHOG_KEY=
# Region host. EU cloud by default; use https://us.i.posthog.com for US cloud.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KokoBrain",
  "version": "2.4.6-alpha",
  "identifier": "com.diegorv.kokobrain",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/tauri-before-build.sh",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "KokoBrain",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.todoist.com https://huggingface.co https://github.com https://objects.githubusercontent.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$HOME/MyFiles/**",
          "$HOME/kokobrain-vault/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "$DOWNLOAD/**",
          "$HOME/Library/Caches/com.diegorv.kokobrain/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kokobrain"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/diegorv/koko.brain/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4QjY2RTJEMDYxRDI3MTkKUldRWkp4MEdMVzYyS0hSdjk4MG9JM0doQndZenVYTnArYWJ0TkRzcVcwNDVlbVVkc1JMYlBhQmwK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
